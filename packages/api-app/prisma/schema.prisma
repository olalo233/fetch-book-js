
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Novel {
  id        String   @id @default(cuid())
  title     String
  author    String?
  tags      String[]
  description String?
  url       String   @unique
  chapters  Chapter[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Chapter {
  id        String   @id @default(cuid())
  novelId   String
  novel     Novel    @relation(fields: [novelId], references: [id], onDelete: Cascade)
  index     Int
  title     String
  content   String
  url       String
  createdAt DateTime @default(now())
}

model AuthToken {
  id        String   @id @default(cuid())
  token     String   @unique
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

