{
	"$schema": "https://biomejs.dev/schemas/1.5.0/schema.json",
	"files": {
		"ignore": ["ocrReplaceDOM.js", "**/dist/**", "**/node_modules/**"]
	},
	"organizeImports": {
		"enabled": false
	},
	"formatter": {
		"enabled": false
	},
	"linter": {
		"rules": {
			"complexity": {
				"noForEach": "off",
				"useLiteralKeys": "off"
			},
			"style": {
				"useImportType": "off",
				"noNonNullAssertion": "off"
			},
			"a11y": {
				"noLabelWithoutControl": "off",
				"useButtonType": "off"
			}
		}
	}
}
